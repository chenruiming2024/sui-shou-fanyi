{
    "build":  {
                  "frontendDist":  "../dist",
                  "beforeBuildCommand":  "npm run build",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev"
              },
    "version":  "1.1.0",
    "bundle":  {
                  "active":  true,
                  "icon":  [
                               "icons/icon.png",
                               "icons/icon.ico"
                           ],
                   "targets":  "nsis"
              },
    "app":  {
                "security":  {
                                 "csp":  null
                             },
